 "sentences": [
  {
   "id": "s01",
   "at": 0.84,
   "end": 3.28,
   "text": "What's new in the Green Zone guide?"
  },
  {
   "id": "s02",
   "at": 3.54,
   "end": 6.02,
   "text": "Here is what changed for you on shift."
  },
  {
   "id": "s03",
   "at": 6.79,
   "end": 9.65,
   "text": "On a weak signal, the guide now answers sooner."
  },
  {
   "id": "s04",
   "at": 10.05,
   "end": 16.23,
   "text": "And the home page offers the last step you opened, so you can pick up where you left off."
  },
  {
   "id": "s05",
   "at": 17.07,
   "end": 23.03,
   "text": "The dengue and cancer pain leaflets now have short films, in English and Bahasa Melayu."
  },
  {
   "id": "s06",
   "at": 23.43,
   "end": 27.59,
   "text": "The first-shift intro can be read aloud in either language."
  },
  {
   "id": "s07",
   "at": 30.64,
   "end": 34.2,
   "text": "In Shift tools, the antidotes quick guide is a tap away."
  },
  {
   "id": "s08",
   "at": 34.6,
   "end": 38.54,
   "text": "Type an abbreviation in search to see what it stands for."
  },
  {
   "id": "s09",
   "at": 39.39,
   "end": 43.75,
   "text": "Reading X-rays shows real films with the normal anatomy outlined."
  },
  {
   "id": "s10",
   "at": 44.14,
   "end": 46.24,
   "text": "Tap a part to find it on the film."
  },
  {
   "id": "s11",
   "at": 46.63,
   "end": 51.05,
   "text": "And over fifty calculators each name the source they are built from."
  },
  {
   "id": "s12",
   "at": 51.89,
   "end": 56.13,
   "text": "Open What's new any time to see what changed since you last looked."
  }
 ],
